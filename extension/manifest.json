{
  "manifest_version": 3,
  "name": "Grocery Deals Near Me - Local Price Finder",
  "version": "1.0.0",
  "description": "Find and compare supermarket discounts and grocery prices within your chosen radius.",
  "permissions": [
    "storage",
    "geolocation",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Grocery Deals Near Me",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
